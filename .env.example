# SQLite database file path for the API (created if missing; parent directories
# are created too). Relative paths resolve against apps/api/.
# Leave unset to use the default: apps/api/.data/app.db
DATABASE_PATH=

# Port the API listens on (pnpm --filter api dev). Defaults to 4000.
# Wins over PORT for the API when both are set.
API_PORT=

# Port the Next.js web client listens on (pnpm --filter web dev). Defaults to 3000.
PORT=
