# SQLite database file path (created if missing; parent directories are created too).
# Relative paths resolve against apps/api/. Leave unset to use the default.
DATABASE_PATH=

# Port the API listens on (pnpm --filter api dev). Defaults to 4000.
API_PORT=

# Port the Next.js web client listens on (pnpm --filter web dev). Defaults to 3000.
PORT=
