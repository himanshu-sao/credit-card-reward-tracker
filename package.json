{
  "name": "credit-card-reward-tracker",
  "private": true,
  "version": "0.0.0",
  "description": "Personal credit-card benefits & rewards tracker (pnpm monorepo)",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write . && pnpm -r format",
    "format:check": "prettier --check . && pnpm -r format:check"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
